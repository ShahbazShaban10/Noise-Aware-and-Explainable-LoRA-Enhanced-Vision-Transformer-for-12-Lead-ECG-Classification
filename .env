# Default settings for `docker compose` run from the repository root.
#
# This file is committed on purpose. It holds no secrets -- only the GPU defaults that make
# a bare `docker compose run --rm solve` do what the README says it does. Docker Compose
# loads it automatically; nothing else reads it.
#
# Override a single value per invocation without editing anything:
#   SMOKE=1 docker compose run --rm solve
#   CHAPMAN_HOST_DIR=/mnt/d/WFDB_ChapmanShaoxing docker compose run --rm solve
#
# For a CPU-only host use .env.cpu instead (or `make build-cpu` / `make test-cpu`):
#   docker compose --env-file .env.cpu -f docker-compose.yml run --rm test

# --- which compose files make up the stack ---------------------------------
# The GPU overlay is on by default. Drop it (`COMPOSE_FILE=docker-compose.yml`) to run
# without a device.
#
# COMPOSE_PATH_SEPARATOR is set explicitly because Compose defaults it to ';' on Windows and
# ':' everywhere else. Without this line the same file means two different things depending
# on the host, and on Windows the ':' below would be read as part of a filename.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# --- image and build ---------------------------------------------------------
ECGVIT_IMAGE=ecgvit:1.0.0
BASE_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
ACCELERATOR=gpu
TORCH_REQUIREMENTS=requirements-cu128.txt

# --- corpus ------------------------------------------------------------------
# Unset means the checksum-pinned subset vendored in this repository, which is the graded
# corpus. Point this at a full PhysioNet WFDBRecords tree to run over the whole database:
#   CHAPMAN_HOST_DIR=/mnt/d/WFDB_ChapmanShaoxing
# CHAPMAN_HOST_DIR=

# --- run settings ------------------------------------------------------------
# The graded schedule, from task.toml [solution.env]. The manuscript's full 150 + 30 is
# reachable by raising these two.
PRETRAIN_EPOCHS=40
LORA_EPOCHS=15
BATCH_SIZE=64
DEVICE=auto
RESOLUTION_ORDER=canonical_v2

# SMOKE=1 runs 2 + 1 epochs: a wiring check whose metrics are meaningless by design.
SMOKE=0

# ALLOW_CPU=1 lets solve.sh train without a CUDA device instead of failing fast. Left at 0
# here so a missing NVIDIA Container Toolkit is reported in seconds rather than discovered
# an hour into a CPU run.
ALLOW_CPU=0
