# CPU-only settings, for a host with no NVIDIA GPU or no NVIDIA Container Toolkit.
#
#   docker compose --env-file .env.cpu -f docker-compose.yml build
#   docker compose --env-file .env.cpu -f docker-compose.yml run --rm test
#   docker compose --env-file .env.cpu -f docker-compose.yml run --rm solve
#
# or, the same thing shorter: `make build-cpu`, `make test-cpu`, `make solve-cpu`.
#
# `-f docker-compose.yml` is passed explicitly rather than through COMPOSE_FILE here:
# --env-file replaces .env entirely, and an explicit -f is the unambiguous way to leave the
# GPU overlay out on every Compose version.
#
# This is NOT the graded path. It builds a different torch wheel (same 2.8.0 pin, CPU
# kernels) into a differently tagged image, so it cannot be confused with ecgvit:1.0.0. Use
# it for the unit tier, for reading the code, and for wiring checks. A full training run on
# CPU takes hours and its metrics are not the manuscript's.

# --- image and build ---------------------------------------------------------
# A distinct tag: a CPU image sitting on ecgvit:1.0.0 would silently replace the graded one.
ECGVIT_IMAGE=ecgvit:1.0.0-cpu
# Ubuntu 22.04 is what the CUDA base is built on, so every apt layer above torch is
# identical between the two images.
BASE_IMAGE=ubuntu:22.04
ACCELERATOR=cpu
TORCH_REQUIREMENTS=requirements-cpu.txt

# --- corpus ------------------------------------------------------------------
# CHAPMAN_HOST_DIR=

# --- run settings ------------------------------------------------------------
# SMOKE=1 by default: on CPU the 40 + 15 schedule runs for hours, and someone reaching for
# this file wants to know the pipeline works, not to wait overnight for numbers that are not
# the graded ones. Set SMOKE=0 and be patient if you do want a full CPU run.
SMOKE=1
PRETRAIN_EPOCHS=40
LORA_EPOCHS=15
# Smaller batches: no GPU means no VRAM ceiling, but 64 x 12 x 5000 float32 through CPU
# matmuls is slow enough to look hung.
BATCH_SIZE=16
DEVICE=cpu
RESOLUTION_ORDER=canonical_v2

# Required: without it solve.sh refuses to run when torch reports no CUDA device, which is
# the whole point of this file.
ALLOW_CPU=1
